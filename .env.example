# --- required -------------------------------------------------------------
# Postgres connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- optional -------------------------------------------------------------
# Set to true if your Postgres host requires TLS (most hosted providers do)
# DATABASE_SSL=true

# Where uploads and extracted games are stored (default: the working directory).
# Point this at a persistent volume in production, e.g. /data
# DATA_DIR=./data

# Size limits in bytes (defaults: 10 GB upload, 20 GB extracted)
# MAX_UPLOAD_BYTES=10737418240
# MAX_EXTRACT_BYTES=21474836480

# Password-protect the library, uploads and deletes (HTTP Basic auth).
# Leave AUTH_PASSWORD empty to disable. The raw game files stay public by design.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me

# Serve games from a different origin so game code is fully isolated from this
# app, e.g. https://games.example.com pointing at the same server.
# This is inlined at BUILD time (pass it as a Docker build arg).
# NEXT_PUBLIC_GAME_ORIGIN=
